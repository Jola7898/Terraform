<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark, like the Studio website's Home page: near-black background, slate
         panels, a soft blue accent with a teal secondary. The Studio itself is
         shown in a WebView and keeps the website's light theme. -->
    <style name="Theme.RtvioMapper" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#0D1622</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">#DCE8FA</item>
        <item name="colorSecondary">@color/accent2</item>
        <item name="colorOnSecondary">#06201C</item>
        <item name="colorSecondaryContainer">#1A3A36</item>
        <item name="colorOnSecondaryContainer">#D3F1EC</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/panel2</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/status_error</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/bg</item>
        <item name="materialCardViewStyle">@style/Widget.Rtvio.Card</item>
        <item name="materialButtonStyle">@style/Widget.Rtvio.Button</item>
    </style>

    <style name="Widget.Rtvio.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/panel</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Rtvio.StudioCard" parent="Widget.Rtvio.Card">
        <item name="cardBackgroundColor">@color/accent_soft</item>
        <item name="strokeColor">@color/accent_line</item>
    </style>

    <style name="Widget.Rtvio.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="StatusLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="StatusValue">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="PreviewOverlay">
        <item name="android:textColor">@color/overlay_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:background">@color/overlay_scrim</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
</resources>
